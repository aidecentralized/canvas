# Backend Server Configuration 

# Port for the server to listen on (default: 4000)
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://main.d40kvw57gjida.amplifyapp.com

# Registry configuration
REGISTRY_API_KEY=your-registry-api-key-here

# Encryption key for credentials (32 hex chars - generate a secure random key)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
