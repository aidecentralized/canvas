# Multi-stage build for AMD64 compatibility
FROM --platform=linux/amd64 node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
COPY server/package*.json ./
COPY server/tsconfig.json ./

# Install all dependencies (including dev dependencies for TypeScript)
RUN npm ci

# Copy application source
COPY server/src ./src

# Build the application
RUN npm run build

# Second stage - create the production image
FROM --platform=linux/amd64 node:20-alpine

WORKDIR /app

# Copy package files
COPY server/package*.json ./

# Install only production dependencies
RUN npm ci --only=production

# Copy built files from the builder stage
COPY --from=builder /app/dist ./dist

# Expose the port
EXPOSE 4000

# Set environment variables
ENV NODE_ENV=production
ENV PORT=4000
# Default CORS settings - override these at runtime for cross-domain deployment
ENV ALLOWED_ORIGINS=http://localhost:3000,https://main.d40kvw57gjida.amplifyapp.com

# Start the server
CMD ["node", "dist/index.js"]